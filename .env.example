# ==============================================================================
# Distributed Auction Engine - Root Environment Template
# Author: Jayavignesh (https://jayavignesh.dev)
# ==============================================================================

# Backend Port
SERVER_PORT=8080

# Database Selection (PostgreSQL 16+ Default, MySQL 8 Supported)
# Option A: PostgreSQL 16+ (Primary Default)
DB_URL=jdbc:postgresql://localhost:5432/livebid_db
DB_DRIVER=org.postgresql.Driver
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SCHEMA_FILE=schema-postgres.sql

# Option B: MySQL 8.0
# DB_URL=jdbc:mysql://localhost:3306/livebid_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# DB_USERNAME=root
# DB_PASSWORD=root
# DB_SCHEMA_FILE=schema.sql

# HikariCP Pool
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_POOL_IDLE_TIMEOUT=300000
DB_POOL_CONN_TIMEOUT=20000
DB_INIT_MODE=always

# Redis Distributed Layer
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT_MS=2000ms

# JWT & CORS
JWT_SECRET=DistributedAuctionEngineSuperSecretJwtKey256BitSecureRandomString2026
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Bidding & Scheduler Rules
ANTI_SNIPE_WINDOW_MINUTES=2
ANTI_SNIPE_EXTENSION_MINUTES=2
BID_MAX_RETRIES=3
AUTO_BID_INCREMENT=10.00
CLOSING_SCHEDULER_RATE_MS=10000
CLOSING_SCHEDULER_BATCH_SIZE=100

