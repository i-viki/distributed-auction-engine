# ==============================================================================
# Distributed Auction Engine - Environment Variable Configuration Template
# Author: Jayavignesh (https://jayavignesh.dev)
# Copy this file to '.env' and adjust values for your environment.
# ==============================================================================

# Server Network Configuration
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# OPTION A: PostgreSQL 16+ Configuration (Default Primary Database)
# ------------------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/livebid_db
DB_DRIVER=org.postgresql.Driver
DB_USERNAME=postgres
DB_PASSWORD=postgrespassword
DB_SCHEMA_FILE=schema-postgres.sql

# ------------------------------------------------------------------------------
# OPTION B: MySQL 8.0 Configuration (Uncomment to use MySQL)
# ------------------------------------------------------------------------------
# DB_URL=jdbc:mysql://localhost:3306/livebid_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# DB_USERNAME=root
# DB_PASSWORD=your_mysql_password
# DB_SCHEMA_FILE=schema.sql

# ------------------------------------------------------------------------------
# Database Connection Pool (HikariCP)
# ------------------------------------------------------------------------------
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_POOL_IDLE_TIMEOUT=300000
DB_POOL_CONN_TIMEOUT=20000
DB_INIT_MODE=always

# ------------------------------------------------------------------------------
# Redis Distributed Layer (Sequencer & Pub/Sub WebSocket Broadcast)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT_MS=2000ms

# ------------------------------------------------------------------------------
# Security, Authentication (JWT) & CORS
# ------------------------------------------------------------------------------
JWT_SECRET=DistributedAuctionEngineSuperSecretJwtKey256BitSecureRandomString2026
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Auction Engine Invariants & Anti-Sniping Parameters
# ------------------------------------------------------------------------------
# Anti-sniping: If a bid is placed within X minutes of end time, extend by Y minutes
ANTI_SNIPE_WINDOW_MINUTES=2
ANTI_SNIPE_EXTENSION_MINUTES=2

# Proxy Bidding Retries & Increment
BID_MAX_RETRIES=3
AUTO_BID_INCREMENT=10.00

# Background Closing Worker Scheduler
CLOSING_SCHEDULER_RATE_MS=10000
CLOSING_SCHEDULER_BATCH_SIZE=100

