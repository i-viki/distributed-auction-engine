# ==============================================================================
# LiveBid Distributed Auction Engine - Docker Environment Configuration Template
# Author: Jayavignesh (https://jayavignesh.dev)
# Copy this file to 'docker/.env' to customize container environment variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System Timezone
# ------------------------------------------------------------------------------
# Set to your desired timezone (e.g. Asia/Kolkata, UTC, America/New_York)
TZ=Asia/Kolkata

# ------------------------------------------------------------------------------
# 2. Host Port Mappings
# ------------------------------------------------------------------------------
FRONTEND_PORT=5173
BACKEND_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=livebid_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword

# ------------------------------------------------------------------------------
# 4. Redis In-Memory Sequencer & Pub/Sub
# ------------------------------------------------------------------------------
REDIS_HOST=redis
# Internal container port (default: 6379)
REDIS_INTERNAL_PORT=6379

# ------------------------------------------------------------------------------
# 5. Security, JWT & CORS
# ------------------------------------------------------------------------------
# Strong 256-bit secret key for HMAC-SHA signing
JWT_SECRET=ProductionDistributedAuctionEngineSecretKeyWithSufficientEntropy256Bits
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173

# ------------------------------------------------------------------------------
# 6. Auction Bidding Engine Invariants & Anti-Sniping
# ------------------------------------------------------------------------------
# Anti-sniping: If a bid arrives within X minutes of end time, extend by Y minutes
ANTI_SNIPE_WINDOW_MINUTES=2
ANTI_SNIPE_EXTENSION_MINUTES=2

# Concurrency & Proxy Auto-Bidding
BID_MAX_RETRIES=3
AUTO_BID_INCREMENT=10.00

# ------------------------------------------------------------------------------
# 7. Background Closing Worker Scheduler
# ------------------------------------------------------------------------------
CLOSING_SCHEDULER_RATE_MS=10000
CLOSING_SCHEDULER_BATCH_SIZE=100

