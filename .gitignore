# ==============================================================================
# Root Monorepo .gitignore
# Distributed Auction Engine (Jayavignesh)
# ==============================================================================

# Backend Build Binaries
backend/target/
target/
*.class

# Frontend Node Modules & Build Assets
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local

# Logs & Diagnostics
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
hs_err_pid*
replay_pid*

# Local Secrets & Environment Variables
.env
.env.*
!.env.example
!**/.env.example

# Python Tests Cache
__pycache__/
*.py[cod]
*$py.class

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.classpath
.project
.settings/
bin/

# Visual Studio Code
.vscode/*
!.vscode/extensions.json

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini
